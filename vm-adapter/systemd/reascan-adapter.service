[Unit]
Description=reascan adapter — REA analysis engine API (port 8787)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/reascan/vm-adapter
Environment=HOME=/home/hatch
Environment=PATH=/home/hatch/.local/bin:/usr/local/bin:/usr/bin:/bin
# Egress proxy for the REA browser forwarder (parsed by lib/reaEnv.js)
EnvironmentFile=/home/hatch/.local/share/proxy.env
# API_KEY + PORT (mode 600, generated by install.sh or manually)
EnvironmentFile=/home/hatch/workspace/reascan/vm-adapter/.env
ExecStart=/home/hatch/.local/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=append:/home/hatch/.local/share/reascan-adapter.log
StandardError=append:/home/hatch/.local/share/reascan-adapter.log

[Install]
WantedBy=multi-user.target
