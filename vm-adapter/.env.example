# reascan adapter environment.
# install.sh copies this to .env (never overwrites an existing .env) and
# generates a random API_KEY on first install. Edit .env, not this file.
#
# The SAME API_KEY must be set as a secret in the Cloudflare Pages dashboard
# (Settings → Environment variables → Add secret).

# Long random string. Requests without it get 401 — including /health.
API_KEY=

# Port the adapter listens on. If you change this, the cloudflared tunnel
# service must point at the same port (install.sh reads it from this file).
PORT=8787
