# reascan adapter environment.
# install.sh copies this to .env (never overwrites an existing .env) and
# generates a random API_KEY on first install. Edit .env, not this file.
#
# The SAME API_KEY must be set as a secret in the Cloudflare Pages dashboard
# (Settings → Environment variables → Add secret).

# Long random string. Requests without it get 401 — including /health.
API_KEY=

# Port the adapter listens on. If you change this, the cloudflared tunnel
# service must point at the same port (install.sh reads it from this file).
PORT=8787

# Interface the adapter binds to. Loopback is deliberate: Cloudflare Tunnel dials
# out to the adapter, so the VM needs no inbound port at all. Binding anything
# wider puts the analysis engine on that interface with only the API key between
# it and the internet. Leave this alone unless something else on the host has to
# reach the adapter.
HOST=127.0.0.1

# --- REA engine (optional) ---------------------------------------------------
# Only needed for the browserCapture / jsDeep categories. Every value below is
# optional: with none of them set, those categories degrade to limitations and
# fingerprint + jsBundle work unaffected. See docs/vm-setup.md §1b.

# Path to the `rea` binary. Leave unset to resolve `rea` from PATH. On Windows
# npm installs only .cmd/.ps1 shims that spawn cannot use; the adapter detects
# that and runs the package's ESM entry through Node instead, so you rarely
# need to set this.
# REA_BIN=

# Chromium used for browser capture. The built-in default targets the VM image.
# REA_CHROME_BIN=/opt/meta-chromium/chrome

# CDP port for that Chromium. Change it if something else already holds 9222 —
# a collision surfaces as an explicit reason, not a silent empty capture.
# REA_CDP_PORT=9222

# Browser profile directory. Defaults to <tmp>/reascan-chrome-profile. A stale
# directory left behind by a killed Chrome makes the next launch exit without
# starting; deleting it is the fix.
# REA_CHROME_PROFILE=

# Set to 1 to pass --ignore-certificate-errors on direct egress. Off by default:
# the flag exists because the VM's egress proxy terminates TLS with its own CA,
# and a host whose certificates are valid must not inherit that bypass. Turn it
# on only when the targets you analyse genuinely serve bad certificates.
# REA_IGNORE_CERT_ERRORS=1
